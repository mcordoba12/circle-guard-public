pipeline {
    agent any

    options {
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        REGISTRY = 'angela912'
        NAMESPACE = 'master'
        SPRING_PROFILES_ACTIVE = 'production'
        BUILD_VERSION = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout + Validate Branch') {
            steps {
                echo "🔄 Checking out and validating branch..."
                checkout(
                    [$class: 'GitSCM',
                     branches: [[name: '*/master']],
                     userRemoteConfigs: [[url: 'https://github.com/mcordoba12/circle-guard-public.git']]]
                )

                script {
                    def branchFromGit = sh(returnStdout: true, script: 'git rev-parse --abbrev-ref HEAD').trim()
                    def branch = env.GIT_BRANCH ?: env.BRANCH_NAME ?: branchFromGit

                    echo "Current branch: ${branch}"

                    if (branch.contains('master')) {
                        echo "✅ Running on master branch"
                    } else if (branch == 'HEAD') {
                        echo "⚠️  Detected detached HEAD (Jenkins checkout mode) - proceeding with MASTER pipeline"
                    } else {
                        echo "ℹ️  Pipeline running from branch: ${branch}"
                    }
                }
            }
        }

        stage('Build auth-service') {
            steps {
                echo "🏗️  Building circleguard-auth-service..."
                sh './gradlew :services:circleguard-auth-service:bootJar -x test'
            }
        }

        stage('Build form-service') {
            steps {
                echo "🏗️  Building circleguard-form-service..."
                sh './gradlew :services:circleguard-form-service:bootJar -x test'
            }
        }

        stage('Unit Tests auth-service') {
            steps {
                echo "🧪 Running unit tests for auth-service..."
                sh './gradlew :services:circleguard-auth-service:unitTest'
            }
        }

        stage('Unit Tests form-service') {
            steps {
                echo "🧪 Running unit tests for form-service..."
                sh './gradlew :services:circleguard-form-service:unitTest'
            }
        }

        stage('Docker Build & Push') {
            steps {
                echo "🐳 Building and pushing Docker images with version tag..."
                withCredentials([usernamePassword(
                    credentialsId: 'DOCKER_HUB_CREDENTIALS',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh '''
                        echo ${DOCKER_PASSWORD} | docker login -u ${DOCKER_USERNAME} --password-stdin

                        for SERVICE in auth-service form-service; do
                            SERVICE_FULL="circleguard-${SERVICE}"
                            IMAGE_TAG="${REGISTRY}/${SERVICE_FULL}:v${BUILD_VERSION}"
                            IMAGE_LATEST="${REGISTRY}/${SERVICE_FULL}:latest"

                            echo "📦 Building image: ${IMAGE_TAG}"
                            docker build \
                              -f services/${SERVICE_FULL}/Dockerfile \
                              -t ${IMAGE_TAG} \
                              -t ${IMAGE_LATEST} \
                              .

                            echo "📤 Pushing image: ${IMAGE_TAG}"
                            docker push ${IMAGE_TAG}

                            echo "📤 Pushing latest tag: ${IMAGE_LATEST}"
                            docker push ${IMAGE_LATEST}
                        done

                        echo "🧹 Cleaning up Docker images..."
                        docker image prune -f --filter "until=72h" || true
                    '''
                }
                echo "✅ Docker images built and pushed successfully"
            }
        }

        stage('Deploy MASTER') {
            steps {
                echo "🚀 Deploying to MASTER namespace..."
                withCredentials([file(credentialsId: 'KUBECONFIG', variable: 'KUBECONFIG_FILE')]) {
                    sh '''
                        export KUBECONFIG=${KUBECONFIG_FILE}

                        # Create namespace if not exists
                        kubectl create namespace master --dry-run=client -o yaml | kubectl apply -f - || {
                            echo "⚠️  Warning: Could not create namespace master, continuing..."
                        }

                        # Deploy all services using the manifest file
                        MANIFEST="k8s/services/master/all-services.yml"
                        if [ -f "$MANIFEST" ]; then
                            echo "Deploying all services to MASTER..."
                            kubectl apply -f "$MANIFEST" -n master
                            echo "✅ Deployment applied"
                        else
                            echo "⚠️  Warning: Manifest not found: $MANIFEST - continuing with deployment..."
                        fi
                    '''
                }
            }
        }

        stage('Generate Release Notes') {
            steps {
                echo "📝 Generating release notes..."
                sh '''
                    # Get the last tag
                    LAST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "")

                    if [ -z "$LAST_TAG" ]; then
                        COMMIT_RANGE="HEAD"
                    else
                        COMMIT_RANGE="${LAST_TAG}..HEAD"
                    fi

                    # Generate release notes file
                    RELEASE_FILE="RELEASE_NOTES.md"
                    RELEASE_DATE=$(date '+%Y-%m-%d %H:%M:%S')

                    cat > $RELEASE_FILE <<EOF
# Release v${BUILD_VERSION} - ${RELEASE_DATE}

## 📋 Summary
This release includes updates to CircleGuard microservices for the MASTER environment.

### ✨ New Features
EOF

                    git log ${COMMIT_RANGE} --oneline --grep="feat:" --format="- %h: %s" >> $RELEASE_FILE 2>/dev/null || echo "- No new features" >> $RELEASE_FILE

                    cat >> $RELEASE_FILE <<EOF

### 🐛 Bug Fixes
EOF

                    git log ${COMMIT_RANGE} --oneline --grep="fix:" --format="- %h: %s" >> $RELEASE_FILE 2>/dev/null || echo "- No bug fixes" >> $RELEASE_FILE

                    cat >> $RELEASE_FILE <<EOF

### 🔧 Maintenance
EOF

                    git log ${COMMIT_RANGE} --oneline --grep="chore:" --format="- %h: %s" >> $RELEASE_FILE 2>/dev/null || echo "- No maintenance updates" >> $RELEASE_FILE

                    cat >> $RELEASE_FILE <<EOF

### 📦 Services Deployed
- circleguard-auth-service:v${BUILD_VERSION}
- circleguard-form-service:v${BUILD_VERSION}

### 🔗 Links
- Build: ${BUILD_URL}
- Git Commit: $(git rev-parse HEAD)

---
Generated on ${RELEASE_DATE}
EOF

                    echo "✅ Release notes generated"
                    cat $RELEASE_FILE
                '''
            }
        }

        stage('Smoke Tests') {
            steps {
                echo "🔥 Running smoke tests..."
                withCredentials([file(credentialsId: 'KUBECONFIG', variable: 'KUBECONFIG_FILE')]) {
                    sh '''
                        export KUBECONFIG=${KUBECONFIG_FILE}

                        echo "📊 Checking pod status in MASTER..."
                        kubectl get pods -n master || {
                            echo "⚠️  Warning: Could not retrieve pod status"
                        }

                        echo "✅ Smoke tests completed"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ MASTER Pipeline completed successfully!"
            sh '''
                echo "Release v${BUILD_VERSION} deployed to MASTER successfully!"
            '''
        }

        failure {
            echo "❌ MASTER Pipeline failed!"
        }

        always {
            echo "🧹 Cleaning up and archiving artifacts..."
            sh '''
                # Archive release notes
                mkdir -p release-artifacts
                cp RELEASE_NOTES.md release-artifacts/ 2>/dev/null || true

                # Clean Docker images
                docker image prune -f --filter "until=72h" || true
            '''

            // Archive artifacts
            archiveArtifacts artifacts: 'release-artifacts/**', allowEmptyArchive: true
        }
    }
}
