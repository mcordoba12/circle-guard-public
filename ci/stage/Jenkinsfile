pipeline {
    agent any

    options {
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        REGISTRY = 'angela912'
        NAMESPACE = 'stage'
        SPRING_PROFILES_ACTIVE = 'stage'
    }

    stages {
        stage('Checkout') {
            steps {
                echo "🔄 Checking out repository..."
                checkout(
                    [$class: 'GitSCM',
                     branches: [[name: '*/develop']],
                     userRemoteConfigs: [[url: 'https://github.com/mcordoba12/circle-guard-public.git']]]
                )
                echo "✅ Checkout completed"
            }
        }

        stage('Build auth-service') {
            steps {
                echo "🏗️  Building circleguard-auth-service..."
                sh './gradlew :services:circleguard-auth-service:bootJar -x test'
            }
        }

        stage('Build form-service') {
            steps {
                echo "🏗️  Building circleguard-form-service..."
                sh './gradlew :services:circleguard-form-service:bootJar -x test'
            }
        }

        stage('Unit Tests auth-service') {
            steps {
                echo "🧪 Running unit tests for auth-service..."
                sh './gradlew :services:circleguard-auth-service:unitTest'
            }
        }

        stage('Unit Tests form-service') {
            steps {
                echo "🧪 Running unit tests for form-service..."
                sh './gradlew :services:circleguard-form-service:unitTest'
            }
        }

        stage('Docker Build & Push') {
            steps {
                echo "🐳 Building and pushing Docker images to Docker Hub..."
                withCredentials([usernamePassword(
                    credentialsId: 'DOCKER_HUB_CREDENTIALS',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh '''
                        echo ${DOCKER_PASSWORD} | docker login -u ${DOCKER_USERNAME} --password-stdin

                        # Build and push auth-service and form-service only
                        for SERVICE in auth-service form-service; do
                            SERVICE_FULL="circleguard-${SERVICE}"
                            IMAGE_TAG="${REGISTRY}/${SERVICE_FULL}:stage-${BUILD_NUMBER}"
                            IMAGE_LATEST="${REGISTRY}/${SERVICE_FULL}:stage-latest"

                            echo "📦 Building image: ${IMAGE_TAG}"
                            docker build \
                              -f services/${SERVICE_FULL}/Dockerfile \
                              -t ${IMAGE_TAG} \
                              -t ${IMAGE_LATEST} \
                              .

                            echo "📤 Pushing image: ${IMAGE_TAG}"
                            docker push ${IMAGE_TAG}

                            echo "📤 Pushing latest tag: ${IMAGE_LATEST}"
                            docker push ${IMAGE_LATEST}
                        done

                        # Clean up old images
                        echo "🧹 Cleaning up Docker images..."
                        docker image prune -f --filter "until=24h" || true
                    '''
                }
                echo "✅ Docker images built and pushed successfully"
            }
        }

        stage('Deploy STAGE') {
            steps {
                echo "🚀 Deploying to STAGE namespace..."
                withCredentials([file(credentialsId: 'KUBECONFIG', variable: 'KUBECONFIG_FILE')]) {
                    sh '''
                        export KUBECONFIG=${KUBECONFIG_FILE}

                        # Create namespace if not exists
                        kubectl create namespace stage --dry-run=client -o yaml | kubectl apply -f -

                        # Deploy auth-service and form-service only
                        for SERVICE in auth-service form-service; do
                            SERVICE_FULL="circleguard-${SERVICE}"
                            MANIFEST="k8s/services/stage/${SERVICE_FULL}.yml"

                            if [ -f "$MANIFEST" ]; then
                                echo "Deploying ${SERVICE_FULL} to STAGE..."
                                IMAGE_TAG="${REGISTRY}/${SERVICE_FULL}:stage-${BUILD_NUMBER}"
                                sed -i "s|image:.*${SERVICE_FULL}.*|image: ${IMAGE_TAG}|g" "$MANIFEST"
                                kubectl apply -f "$MANIFEST" -n stage
                            else
                                echo "⚠️  Manifest not found: $MANIFEST"
                            fi
                        done

                        echo "✅ Deployment to STAGE initiated"
                        sleep 15
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                echo "🏥 Running basic health check..."
                withCredentials([file(credentialsId: 'KUBECONFIG', variable: 'KUBECONFIG_FILE')]) {
                    sh '''
                        export KUBECONFIG=${KUBECONFIG_FILE}

                        echo "Waiting for pods to be ready..."
                        kubectl rollout status deployment/circleguard-auth-service -n stage --timeout=2m || true
                        kubectl rollout status deployment/circleguard-form-service -n stage --timeout=2m || true

                        echo "Pod status:"
                        kubectl get pods -n stage -o wide

                        echo "✅ Health check completed"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ STAGE Pipeline completed successfully!"
        }

        failure {
            echo "❌ STAGE Pipeline failed!"
        }

        always {
            echo "🧹 Pipeline finished"
        }
    }
}
